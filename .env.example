# SQLite and upload locations (defaults are project-local)
AGRISHIELD_DB_PATH=agrishield.db
AGRISHIELD_UPLOAD_DIR=uploads

# Provider request settings
AGRISHIELD_PROVIDER_TIMEOUT=8
AGRISHIELD_USER_AGENT=AgriShield/1.0
# Optional contact is useful for the public Nominatim reverse-geocoding service
AGRISHIELD_CONTACT=

# Optional authoritative GeoJSON for point-to-administrative-boundary lookup.
# Matching enriches labels only; it does not aggregate forecasts to an area.
# AGRISHIELD_BOUNDARY_GEOJSON=data/boundaries/official-admin.geojson

# Leave blank when frontend and Flask are served on the same origin.
# For a separate frontend origin, set this to that exact origin, e.g. https://app.example.org
AGRISHIELD_ALLOWED_ORIGIN=

# Flask/Gunicorn listener (development defaults to 8000)
PORT=8000

# Optional frontend API origin. Leave unset to use same-origin /api URLs.
# VITE_API_BASE_URL=
